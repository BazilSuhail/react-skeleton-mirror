{
  "name": "react-skeleton-mirror",
  "version": "1.6.0",
  "description": "CLI tool that analyzes your React components and generates skeleton loading components with zero runtime cost",
  "main": "dist/cli.js",
  "bin": {
    "skeletonify": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
